{
  "name": "mcp-camoufox",
  "version": "0.13.2",
  "description": "MCP server for browser automation with Camoufox: 135 tools, plus an HTTP path with a Firefox TLS fingerprint",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "mcp-camoufox": "dist/index.js"
  },
  "files": [
    "dist/**/*",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "dev": "tsc --watch",
    "prepublishOnly": "npm run build",
    "test": "node scripts/test.mjs",
    "test:schema": "node scripts/tool-schema-snapshot.mjs",
    "test:sweep": "node scripts/test/sweep.mjs",
    "smoke:install": "node scripts/smoke-fresh-install.mjs",
    "audit:tools": "node scripts/audit-tools.mjs",
    "smoke:real": "node scripts/smoke-real-sites.mjs"
  },
  "keywords": [
    "mcp",
    "camoufox",
    "browser",
    "automation",
    "stealth",
    "anti-detection",
    "playwright",
    "modelcontextprotocol",
    "claude"
  ],
  "author": "RobithYusuf <robithdev@gmail.com>",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/RobithYusuf/mcp-camoufox.git"
  },
  "bugs": {
    "url": "https://github.com/RobithYusuf/mcp-camoufox/issues"
  },
  "homepage": "https://github.com/RobithYusuf/mcp-camoufox#readme",
  "engines": {
    "node": ">=18.0.0"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0",
    "camoufox-js": "^0.10.2",
    "impit": "^0.13.0",
    "playwright-core": ">=1.55.0 <1.61.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@types/node": "^25.6.0",
    "typescript": "^6.0.2"
  },
  "overrides": {
    "adm-zip": "0.6.0",
    "brace-expansion": "^5.0.9"
  }
}
